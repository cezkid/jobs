{
  "files.exclude": {
    "app": true,
    "docs": true,
    "**/.data": true,
    ".agents": true,
    ".claude": true,
    ".codex": true,
    ".github": true,
    ".vscode": true,
    ".venv": true,
    ".pytest_cache": true,
    "**/__pycache__": true,
    ".gitattributes": true,
    ".gitignore": true,
    "AGENTS.md": true,
    "CLAUDE.md": true,
    "README.md": true,
    "pyproject.toml": true,
    "uv.lock": true
  },
  // red underline the moment a resume fact is mistyped, instead of an error hours later at render
  "yaml.schemas": {
    "./app/resume/details.schema.json": "My Resume/Resume details.yml"
  },
  "yaml.validate": true,
  "yaml.format.enable": false,
  // by name => My Jobs reads in pipeline order (1 To apply ... 4 Closed), jobs by number inside;
  // "modified" reshuffled the stages every time a job moved
  "explorer.sortOrder": "default",
  // a stage holding one job stays its own row, not "1 To apply / Job 3 - ..." squeezed on one line
  "explorer.compactFolders": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  // one program, not a code editor: developer controls out of sight, nothing the user needs gone.
  // Tab buttons + status bar stay: Claude's new-chat and open-chat buttons live there
  // Tabs stay (START HERE, resume, posting side by side); file list + its icons stay, moved to a
  // small row on top (ChatGPT's icon lives there)
  "window.title": "CEZ Job Finder",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.activityBar.location": "top",
  "workbench.editor.empty.hint": "hidden",
  "breadcrumbs.enabled": false,
  "explorer.openEditors.visible": 0,
  "editor.minimap.enabled": false,
  // else VS Code's own Copilot chat owns the right-hand panel and the user talks to it, not Claude/ChatGPT
  "chat.disableAIFeatures": true,
  // chat in the right-hand sidebar: the default opens it as a tab and leaves that sidebar empty
  "claudeCode.preferredLocation": "sidebar",
  // right-hand sidebar shown on open => START HERE / Today in the middle, chat beside it
  "workbench.secondarySideBar.defaultVisibility": "visible",
  // no developer checklist in the chat; only prompts + answers, steps one click away
  "claudeCode.hideOnboarding": true,
  "claudeCode.focusView": true,
  "extensions.ignoreRecommendations": true,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "git.openRepositoryInParentFolders": "never",
  "scm.showActionButton": false
}
