{
  "name": "window",
  "publisher": "cez-job-finder",
  "displayName": "CEZ Job Finder window",
  "description": "Job Finder's own window: start page, Today dashboard and app look. Local only, never on the Marketplace.",
  "version": "0.4.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:cezJobFinder.today"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "cezJobFinder.today",
        "displayName": "Today",
        "selector": [
          {
            "filenamePattern": "Today.md"
          }
        ],
        "priority": "option"
      }
    ]
  }
}
